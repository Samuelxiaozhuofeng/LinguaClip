{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LinguaClip",
  "version": "0.3.0",
  "identifier": "com.linguaclip.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LinguaClip",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 32
        }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0MzE4Qzc0RTBGNEExNUMKUldSY29mVGdkSXd4aExHcWlZZHdBNGxTNzlXTVFXRUc1S2tNMnNOUnJLM05RTnd6V1lwd0p5UW4K",
      "endpoints": [
        "https://linguaclipapp.com/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
